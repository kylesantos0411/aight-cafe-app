# Aight Cafe — Environment Variables Configuration
# Copy this file to .env.local for local development.
# In Vercel, configure these in Project Settings -> Environment Variables.

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Public Key (Safe for browser/frontend usage with RLS enabled)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Store Location and Metadata Override
VITE_STORE_NAME="Aight Cafe"
VITE_STORE_LOCATION="The Courtyard"
VITE_STORE_TIMEZONE="Asia/Manila"
